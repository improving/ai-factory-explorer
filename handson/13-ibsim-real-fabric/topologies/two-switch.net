# IB05 topology: two switches, one inter-switch link, no redundancy.
#
#   Hca1   Hca2
#     \    /
#    Switch1
#       |
#    Switch2
#     /    \
#   Hca3   Hca4
#
# Deliberately has exactly ONE link between Switch1 and Switch2 (contrast with topologies/multipath.net,
# which gives the same shape two independent paths). Any single link failure here partitions the fabric
# — that's the point: IB05 shows this is a real fabric, IB10 later breaks this exact link on purpose.

Switch	8 "Switch1"
[1]	"Hca1"[1]
[2]	"Hca2"[1]
[3]	"Switch2"[3]

Switch	8 "Switch2"
[1]	"Hca3"[1]
[2]	"Hca4"[1]
[3]	"Switch1"[3]

Hca	2 "Hca1"
[1]	"Switch1"[1]

Hca	2 "Hca2"
[1]	"Switch1"[2]

Hca	2 "Hca3"
[1]	"Switch2"[1]

Hca	2 "Hca4"
[1]	"Switch2"[2]
