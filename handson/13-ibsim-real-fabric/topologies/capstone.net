# IB20 capstone topology: a diamond (like multipath.net) with TWO hosts on each side instead of one,
# so a partial-reachability symptom ("some HCAs reachable, others not") is meaningful.
#
#              Switch1
#             /       \
#            /         \
#        Switch2       Switch3
#            \         /
#             \       /
#              Switch4
#             /   |   \    \
#          Hca1 Hca3  Hca2 Hca4
#
# Hca1, Hca3 attach to Switch1. Hca2, Hca4 attach to Switch4.
# Two independent switch-level paths exist between Switch1 and Switch4 (via Switch2, via Switch3) --
# exactly like topologies/multipath.net, just with 4 HCAs instead of 2 for a richer capstone scenario.

Switch	8 "Switch1"
[1]	"Hca1"[1]
[2]	"Switch2"[1]
[3]	"Switch3"[1]
[4]	"Hca3"[1]

Switch	8 "Switch2"
[1]	"Switch1"[2]
[2]	"Switch4"[1]

Switch	8 "Switch3"
[1]	"Switch1"[3]
[2]	"Switch4"[2]

Switch	8 "Switch4"
[1]	"Switch2"[2]
[2]	"Switch3"[2]
[3]	"Hca2"[1]
[4]	"Hca4"[1]

Hca	2 "Hca1"
[1]	"Switch1"[1]

Hca	2 "Hca3"
[1]	"Switch1"[4]

Hca	2 "Hca2"
[1]	"Switch4"[3]

Hca	2 "Hca4"
[1]	"Switch4"[4]
